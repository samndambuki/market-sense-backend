// ------------------------------------------------------------

### MARKET ENDPOINTS

// -------------------------------------------------------------

### Get all markets
GET http://LOCALHOST:4000/api/markets

### Get market by id
GET http://localhost:4000/api/markets/1 



### CREATE ENDPOINTS

### Create market 1 
POST http://localhost:4000/api/markets
Content-Type: application/json

{
    "name": "Health Insurance",
    "category": "Heathcare",
    "region": "East Africa",
    "growthRate": 8.5,
    "description": "A growing healthcare insurance market",
    "marketSize": "KSH 10 billion",
    "riskLevel": "MEDIUM"
}


### Create Market 2
POST http://localhost:4000/api/markets
Content-Type: application/json

{
  "name": "Agricultural Technology",
  "category": "Agritech",
  "region": "East Africa",
  "growthRate": 10.8,
  "description": "Technology solutions for farmers, including precision agriculture, digital marketplaces, and smart irrigation.",
  "marketSize": "KSh 35 billion",
  "riskLevel": "LOW"
}

### Create market 3 - Fintech
POST http://localhost:4000/api/markets
Content-Type: application/json

{
  "name": "Digital Payments",
  "category": "Fintech",
  "region": "East Africa",
  "growthRate": 14.7,
  "description": "Digital payment services including mobile money and online transactions.",
  "marketSize": "KSh 120 billion",
  "riskLevel": "LOW"
}

### Create market 4 - E-commerce
POST http://localhost:4000/api/markets
Content-Type: application/json

{
  "name": "E-commerce",
  "category": "Retail",
  "region": "East Africa",
  "growthRate": 12.3,
  "description": "Online retail platforms connecting consumers with merchants.",
  "marketSize": "KSh 85 billion",
  "riskLevel": "MEDIUM"
}

### Create market 5 - Renewable Energy
POST http://localhost:4000/api/markets
Content-Type: application/json

{
  "name": "Renewable Energy",
  "category": "Energy",
  "region": "East Africa",
  "growthRate": 10.2,
  "description": "Solar, wind and other renewable energy solutions for homes and businesses.",
  "marketSize": "KSh 70 billion",
