### Create market 6 - Real Estate
POST http://localhost:4000/api/markets
Content-Type: application/json

{
  "name": "Commercial Real Estate",
  "category": "Real Estate",
  "region": "Nairobi, Kenya",
  "growthRate": 4.8,
  "description": "Commercial properties including offices, retail spaces and business parks.",
  "marketSize": "KSh 200 billion",
  "riskLevel": "HIGH"
}

### Test invalid market data
POST http://localhost:4000/api/markets
Content-Type: application/json

{
  "name": "",
  "category": "Fintech",
  "region": "East Africa",
  "growthRate": "invalid",
  "description": "Test market",
  "marketSize": "KSh 10 billion",
  "riskLevel": "EXTREME"
}


### UPDATE ENDPOINTS


### Update existing market
PUT http://localhost:4000/api/markets/1
Content-Type: application/json

{
    "name":"Health Insurance",
    "category":"Healtchcare",
    "region":"East Africa",
    "growthRate":9.1,
    "description":"A growing healthcare insurance market with increasing demand for private medical cover.",
    "marketSize":"Ksh 12 billion",
    "riskLevel":"MEDIUM"
}

### Test update validation - invalid data
PUT http://localhost:4000/api/markets/1
Content-Type: application/json

{
  "name": "",
  "category": "Fintech",
  "region": "East Africa",
  "growthRate": "invalid",
  "description": "Updated test market",
  "marketSize": "KSh 10 billion",
  "riskLevel": "EXTREME"
}



### DELETE ENDPOINTS


### DELETE existing market
DELETE http://localhost:4000/api/markets/2
Content-Type: application/json

### Test invalid ID
DELETE http://localhost:4000/api/markets/abc

### Test non-existent market
DELETE http://localhost:4000/api/markets/999999


// ----------------------------------------------------------

### MARKET PLAYER ENDPOINTS

// -----------------------------------------------------------


###Get all market players
GET http://localhost:4000/api/marketPlayers


### Get company
GET http://localhost:4000/api/marketPlayers/0


### Create Market Name
POST http://localhost:4000/api/marketPlayers
Content-Type: application/json

{
  "companyName":"Jubilee Insurance",
  "marketId":1
}



### Create Market Name
POST http://localhost:4000/api/marketPlayers
Content-Type: application/json

{
  "companyName":"Old Mutual",
  "marketId":1
}


### Update Market Player
PUT http://localhost:4000/api/marketPlayers/1
Content-Type: application/json

{
  "companyName":"Jubilee Health Insurance",
  "marketId":1
}


### DELETE marketPlayer
DELETE http://localhost:4000/api/marketPlayers/4




// --------------------------------------------

## AI ENDPOINTS

// --------------------------------------------

### Generate AI market summary
GET http://localhost:4000/api/ai/market-summary/1

### AI competitor analysis
GET http://localhost:4000/api/ai/competitorAnalysis/1



// --------------------------------------------------

### AUTHENTICATION ENDPOINTS 

// ---------------------------------------------------


### Register Endpoint
POST http://localhost:4000/api/auth/register
Content-Type: application/json

{
  "fullName":"Samuel Developer",
  "email":"samuel@example.com",
  "password":"Password123!"
}


### Login Endpoint
POST http://localhost:4000/api/auth/login
Content-Type: application/json

{
  "email":"samuel@example.com",
  "password":"Password123!"
}